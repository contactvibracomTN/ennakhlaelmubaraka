# Admin panel — copy this file to `.env.local` and fill in real values.
# NO values are required: if ADMIN_PASSWORD/ADMIN_SECRET are empty, the panel
# auto-generates a random password on first use (see .admin/password).

# Password to access /admin (choose a long one, e.g. 12+ chars).
ADMIN_PASSWORD=DaliD2026*+/

# Random string used to sign admin session cookies (any long random string).
ADMIN_SECRET=

# Google Cloud Translation API key (https://cloud.google.com/translate).
# v2 REST endpoint — only the API key is needed (no service account).
# Leave empty to keep the "Traduire" buttons disabled (manual writing only).
GOOGLE_TRANSLATE_API_KEY=

# Optional: which locale is the authoring/translation source (ar | en | fr | ...).
ADMIN_SOURCE_LOCALE=ar

# Git display identity used for automatic backup commits (defaults shown).
GIT_ADMIN_NAME=Nakhla Admin
GIT_ADMIN_EMAIL=admin@ennakhlaelmubaraka.com

# ---------------------------------------------------------------------------
# Bank transfer details (Al Rajhi Bank — VALIDATED 24/09/2026, cert. 54997526)
# ---------------------------------------------------------------------------
# These are rendered on /[locale]/payment and inside the checkout when the
# customer picks "bank transfer". They are inlined into the client bundle by
# `next build`, which is correct: a bank account holder must be public.
#
# NEVER invent a value here. While any of them is empty the payment page hides
# the copy button and shows "bank details being confirmed" instead. Copy the
# four values from the official bank certificate into `.env.local`.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# Provenance of the four values above, printed on /[locale]/payment so the
# customer can see the details come from an official bank certificate.
# Example: 54997526 / 24/09/2026
NEXT_PUBLIC_BANK_CERT_REF=
NEXT_PUBLIC_BANK_CERT_DATE=