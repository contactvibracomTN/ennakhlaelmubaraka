# Admin panel — copy this file to `.env.local` and fill in real values.
# NO values are required: if ADMIN_PASSWORD/ADMIN_SECRET are empty, the panel
# auto-generates a random password on first use (see .admin/password).

# Password to access /admin (choose a long one, e.g. 12+ chars).
# Leave empty to auto-generate on first local use (stored in .admin/password).
ADMIN_PASSWORD=

# Random string used to sign admin session cookies (any long random string).
ADMIN_SECRET=

# Neon Postgres (production). Use the pooled connection string, with sslmode=require.
# Leave empty to keep testimonials in the local JSON file.
DATABASE_URL=

# Google Cloud Translation API key (https://cloud.google.com/translate).
# v2 REST endpoint — only the API key is needed (no service account).
# Leave empty to keep the "Traduire" buttons disabled (manual writing only).
GOOGLE_TRANSLATE_API_KEY=

# Optional: which locale is the authoring/translation source (ar | en | fr | ...).
ADMIN_SOURCE_LOCALE=ar

# Git display identity used for admin commits on the dev branch (defaults shown).
GIT_ADMIN_NAME=Nakhla Admin
GIT_ADMIN_EMAIL=admin@ennakhlaelmubaraka.com

# ---------------------------------------------------------------------------
# Online admin on Vercel — write JSON + images to GitHub instead of disk.
# Leave ALL of these empty for the original local-file workflow (npm run dev).
# Set them in Vercel for BOTH "Preview" and "Production" environments.
# NEVER prefix with NEXT_PUBLIC_: GITHUB_TOKEN is a write secret.
# ---------------------------------------------------------------------------

# Fine-grained token with "Contents: read and write" on this repository.
GITHUB_TOKEN=

# Repository in "owner/repo" form (example: ennakhlaelmubaraka/nakhla-v3).
GITHUB_REPO=

# Branch receiving every admin commit. Promotion to main stays manual in git.
GITHUB_BRANCH=dev

# Optional: custom GitHub API base (GitHub Enterprise). Defaults to api.github.com.
GITHUB_API_URL=

# Optional Vercel deploy hook bound to the dev branch. The "Déployer" button
# calls it; Vercel also auto-deploys on each commit when Git is connected.
VERCEL_DEPLOY_HOOK_URL_DEV=

# Optional public URL of the dev preview, displayed in /admin/deploy.
VERCEL_DEV_PREVIEW_URL=

# Required in online mode: without ADMIN_SECRET sessions cannot be signed,
# and without ADMIN_PASSWORD the login page cannot authenticate anyone.
# The panel shows an explicit error instead of crashing when they are absent.
# ADMIN_PASSWORD and ADMIN_SECRET are declared at the top of this file.

# ---------------------------------------------------------------------------
# Bank transfer details (Al Rajhi Bank — VALIDATED 24/09/2026, cert. 54997526)
# ---------------------------------------------------------------------------
# These are rendered on /[locale]/payment and inside the checkout when the
# customer picks "bank transfer". They are inlined into the client bundle by
# `next build`, which is correct: a bank account holder must be public.
#
# NEVER invent a value here. While any of them is empty the payment page hides
# the copy button and shows "bank details being confirmed" instead. Copy the
# four values from the official bank certificate into `.env.local`.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# Provenance of the four values above, printed on /[locale]/payment so the
# customer can see the details come from an official bank certificate.
# Example: 54997526 / 24/09/2026
NEXT_PUBLIC_BANK_CERT_REF=
NEXT_PUBLIC_BANK_CERT_DATE=

# ---------------------------------------------------------------------------
# Meta — server-only secrets. See docs/meta-integration-plan.md.
# NEVER add a NEXT_PUBLIC_ prefix: these values must never reach the browser.
# Generate one System User token per usage and keep the old token revoked.
# Meta now recommends 60-day expiring system user tokens with rotation.
# Pixel/Dataset in use: 2369842980424778 (already in site.config.ts).
# ---------------------------------------------------------------------------

# Conversions API token, generated from Events Manager for the Pixel/Dataset.
META_CAPI_TOKEN=

# Read-only Marketing API token: ads_read.
META_ADS_TOKEN=

# Write token for campaign changes: ads_management.
META_CAMPAIGN_TOKEN=

# Ads MCP token: ads_mcp_management + ads_read or ads_management.
# Must be an EMPLOYEE-role System User token. Admin-role tokens are rejected.
META_MCP_TOKEN=

# Meta App ID. Needed only if an MCP client requires a developer-provided ID.
META_APP_ID=

# Read-only token for the local "meta-content" MCP: Page posts, IG media and insights.
# The MCP reads this from the OpenCode process environment, or falls back to this
# .env.local file. Keep it server-only; write scopes are not granted for now.
META_CONTENT_TOKEN=

# Verification string for Meta webhooks. Leave empty if webhooks are not used.
META_WEBHOOK_VERIFY_TOKEN=

# App secret. Fill only if token exchange or signed requests are needed.
META_APP_SECRET=